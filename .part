        <!-- Reporte del Libro Mayor -->
        <div class="box box-info">
            <div class="box-header with-border">
                <h3 class="box-title">Reporte de Libro Mayor</h3>
            </div>
            <div class="box-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Cuenta</th>
                                <th>Descripción</th>
                                <th>Debe</th>
                                <th>Haber</th>
                                <th>Saldo</th>
