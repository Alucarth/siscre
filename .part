                        </thead>
                        <tbody>
                            <?php 
                            $saldo_acumulado = 0;
                            $cuenta_actual = null;
                            ?>
                            
                            <?php foreach ($ledger_data as $row): ?>
                                <?php 
                                // Calcular saldo
                                $saldo_acumulado += ($row->debe - $row->haber);
                                ?>
                                
                                <tr>
                                    <td><?= date('d/m/Y', strtotime($row->fecha)) ?></td>
                                    <td><?= $row->cuenta_codigo ?> - <?= $row->cuenta_nombre ?></td>
                                    <td><?= $row->descripcion ?></td>
                                    <td class="text-right"><?= number_format($row->debe, 2) ?></td>
                                    <td class="text-right"><?= number_format($row->haber, 2) ?></td>
                                    <td class="text-right"><?= number_format($saldo_acumulado, 2) ?></td>
                                </tr>
                            <?php endforeach; ?>
                            
                            <?php if (empty($ledger_data)): ?>
                                <tr>
                                    <td colspan="6" class="text-center">No se encontraron registros</td>
                                </tr>
                            <?php endif; ?>
                        </tbody>
                    </table>
                </div>
            </div>
